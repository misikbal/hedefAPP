# Yalnızca örnek değerler. Gerçek değerleri .env dosyasına (git'e girmez) veya Coolify'a yaz.
NODE_ENV=development
PORT=3000
# Geliştirme (docker-compose.dev.yml): mongodb://127.0.0.1:27018/takip
# Üretim: mongodb://takip_app:<şifre>@<coolify-iç-servis-adı>:27017/takip?authSource=takip
MONGODB_URI=mongodb://127.0.0.1:27018/takip
# openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
# openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
MCP_SECRET=change-me-url-safe-secret-at-least-32-chars
APP_TIMEZONE=Europe/Istanbul
LOG_LEVEL=info
# Üretimde Coolify/Traefik arkasında: true (rate limit gerçek istemci IP'sini görsün)
TRUST_PROXY=false
# İsteğe bağlı: tarayıcıdan erişecek kökenler, virgülle (mobil uygulama gerektirmez)
CORS_ORIGINS=
# IP başına dakikadaki istek sınırı (giriş: 10/dk, dışa aktarma: 5/dk sabit)
RATE_LIMIT_MAX=300
# İsteğe bağlı
EXPO_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
# Yalnızca ilk çalıştırmada seed için; sonra sil
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
