# Telefonun API’ye ulaşması için bilgisayarın yerel IP adresi (localhost telefonda çalışmaz)
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1
# Push (Faz 5): `eas init` sonrası proje kimliği (gizli değil). Boşsa push token alınmaz.
EAS_PROJECT_ID=
# Yerel `expo run:android` için Firebase dosyası (EAS Build'de dosya değişkeni olarak tanımlanır)
GOOGLE_SERVICES_JSON=
