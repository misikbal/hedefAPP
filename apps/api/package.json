{
  "name": "@takip/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @takip/shared build && tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @takip/shared build && vitest run",
    "seed:demo": "pnpm --filter @takip/shared build && tsx --env-file-if-exists=../../.env src/scripts/seedDemo.ts"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "4.0.5",
    "@date-fns/tz": "^1.5.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@takip/shared": "workspace:*",
    "agenda": "6.2.8",
    "argon2": "^0.45.2",
    "date-fns": "^4.4.0",
    "expo-server-sdk": "^8.0.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "mongoose": "^9.13.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "mongodb-memory-server": "^11.4.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
